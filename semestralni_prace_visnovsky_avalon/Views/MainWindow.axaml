<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:semestralni_prace_visnovsky_avalon"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        x:Class="semestralni_prace_visnovsky_avalon.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Můj Správce Financí" Width="1250" Height="850"
        Background="#09090B" Foreground="#FAFAFA"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="#0E0E0F"/>
            <Setter Property="BorderBrush" Value="#313133"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
        <Style Selector="RadioButton.tab">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Foreground" Value="#FAFAFA"/>
        </Style>
    </Window.Styles>

    <Grid Margin="30" RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton x:Name="NavMain" Content="Hlavní přehled" Classes="tab" GroupName="MainMenu" IsChecked="True"/>
            <RadioButton x:Name="NavExtended" Content="Rozšířené funkce" Classes="tab" GroupName="MainMenu"/>
        </StackPanel>

        <Grid Grid.Row="1" IsVisible="{Binding #NavMain.IsChecked}" RowDefinitions="Auto, Auto, Auto, Auto, *, Auto">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,30">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Můj správce financí" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Aktivní účet:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A1A1AA" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding AccountNames}" SelectedItem="{Binding SelectedAccountName}" Text="{Binding SelectedAccountName}" IsEditable="True" Width="140" Background="#18181B" BorderBrush="#27272A" Padding="8,4" FontSize="13"/>
                    <Button Command="{Binding AddAccountCommand}" Content="+" Classes="secondary" Margin="5,0,0,0" Padding="12,4"/>
                    <Button Command="{Binding DeleteAccountCommand}" Content="✕" Classes="secondary" Foreground="#AD3434" Margin="5,0,0,0" Padding="12,4"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*, 400" Margin="0,0,0,30">
                <Border Grid.Column="0" Classes="Card" Padding="30" Margin="0,0,20,0" VerticalAlignment="Stretch">
                     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="SectionTitle" Text="ZŮSTATEK NA ÚČTU" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding BalanceText}" FontSize="48" HorizontalAlignment="Center" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card" Padding="20">
                    <Grid RowDefinitions="Auto, *">
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                              <TextBlock Classes="SectionTitle" Text="ZA CO UTRÁCÍM" FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                              <TextBlock Text="Posledních 30 dní" Foreground="#52525B" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>                    
                        <ScrollViewer Grid.Row="1" MaxHeight="150" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CategoryStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="100, *, 80" Margin="0,0,0,15">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#FAFAFA" FontSize="13" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Percentage}" Foreground="{Binding Color}" Background="#27272A" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="10,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedAmount}" Foreground="#A1A1AA" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                <RadioButton x:Name="tab7Days" Classes="tab" Content="Posledních 7 dní" IsChecked="True"/>
                <RadioButton x:Name="tabAll" Classes="tab" Content="Všechny výdaje" IsChecked="{Binding IsAllTimeChecked}" />
            </StackPanel>

            <Border Grid.Row="3" Classes="Card" Padding="15,10" Margin="0,0,0,15" IsVisible="{Binding #tabAll.IsChecked}">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                   <StackPanel Margin="0,0,15,5">
                        <TextBlock Classes="SectionTitle" Text="KATEGORIE" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding AllCategories}" SelectedItem="{Binding FilterCategoryName}" Width="120" Padding="8,6" FontSize="12" PlaceholderText="Všechny"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Classes="SectionTitle" Text="OD" FontSize="10" Margin="0,0,0,2"/>
                        <CalendarDatePicker SelectedDate="{Binding FilterDateFrom}" Width="110" Padding="8,6" FontSize="12" Watermark="Od..."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Classes="SectionTitle" Text="DO" FontSize="10" Margin="0,0,0,2"/>
                        <CalendarDatePicker SelectedDate="{Binding FilterDateTo}" Width="110" Padding="8,6" FontSize="12" Watermark="Do..."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Classes="SectionTitle" Text="ČÁSTKA (OD-DO)" FontSize="10" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding FilterMinAmountStr}" Width="60" Padding="8,6" FontSize="12" Watermark="Min" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding FilterMaxAmountStr}" Width="60" Padding="8,6" FontSize="12" Watermark="Max"/>
                        </StackPanel>
                   </StackPanel>
                   <StackPanel Margin="0,0,15,5">
                        <TextBlock Classes="SectionTitle" Text="SEŘADIT" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox SelectedIndex="{Binding FilterSortOrderIndex}" Width="120" Padding="8,6" FontSize="12">
                            <ComboBoxItem Content="Nejnovější"/>
                            <ComboBoxItem Content="Nejstarší"/>
                            <ComboBoxItem Content="Nejvyšší"/>
                            <ComboBoxItem Content="Nejnižší"/>
                        </ComboBox>
                   </StackPanel>
                   <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <Button Content="Použít" Command="{Binding ApplyFilterCommand}" Classes="primary" Padding="12,6" FontSize="12" Margin="0,0,10,0"/>
                        <Button Content="Zrušit" Command="{Binding ResetFilterCommand}" Classes="secondary" Padding="12,6" FontSize="12"/>
                   </StackPanel>
                </WrapPanel>
            </Border>

            <Border Grid.Row="4" Classes="Card" Padding="10">
                <DataGrid ItemsSource="{Binding FilteredTransactions}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" GridLinesVisibility="None" HeadersVisibility="None" RowHeight="60" BorderThickness="-2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding DateAndTime, StringFormat={}{0:dd. MM. yyyy}}" Width="120"/>
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Category.Color, FallbackValue='#27272A'}" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category.Name}" Foreground="#FAFAFA" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="secondary" Content="Detail" Padding="15,5" FontSize="11" Command="{Binding $parent[Window].DataContext.OpenDetailCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedAmount}" Foreground="{Binding AmountColor}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button x:Name="btnExit" Classes="secondary" Content="Uložit a Zavřít" Margin="0,0,15,0" Click="BtnExit_Click"/>
                <Button x:Name="btnAdd" Classes="primary" Content="+ Přidat transakci" Click="BtnAdd_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" IsVisible="{Binding #NavExtended.IsChecked}" 
              ColumnDefinitions="*, 350" RowDefinitions="Auto, Auto, *">

            <Border Grid.Row="0" Grid.Column="0" Classes="Card" Margin="0,0,20,10" Padding="15">
                <Grid ColumnDefinitions="Auto, 100, 150, *, Auto">
                    <TextBlock Grid.Column="0" Text="CÍL SPOŘENÍ" Classes="SectionTitle" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBox Grid.Column="1" Text="{Binding ExtendedVm.SavingsGoalText}" Watermark="Kč" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,10,0"/>
                    <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding ExtendedVm.SavingsDeadline}" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,20,0"/>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <ProgressBar Value="{Binding ExtendedVm.SavingsProgress}" Foreground="{Binding ExtendedVm.SavingsColor}" Background="#27272A" Height="4" CornerRadius="2" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding ExtendedVm.SavingsMessage}" Foreground="{Binding ExtendedVm.SavingsColor}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding ExtendedVm.CurrentSaved, StringFormat='{}{0:N0} Kč'}" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Classes="Card" Margin="0,0,20,15" Padding="15">
                <Grid ColumnDefinitions="Auto, 100, 150, *, Auto">
                    <TextBlock Grid.Column="0" Text="VÝDAJOVÝ LIMIT" Classes="SectionTitle" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBox Grid.Column="1" Text="{Binding ExtendedVm.ExpenseLimitText}" Watermark="Kč" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,10,0"/>
                    <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding ExtendedVm.ExpenseDeadline}" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,20,0"/>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <ProgressBar Value="{Binding ExtendedVm.ExpenseProgress}" Foreground="{Binding ExtendedVm.ExpenseColor}" Background="#27272A" Height="4" CornerRadius="2" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding ExtendedVm.ExpenseMessage}" Foreground="{Binding ExtendedVm.ExpenseColor}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>  
                    <TextBlock Grid.Column="4" Text="{Binding ExtendedVm.CurrentSpent, StringFormat='{}{0:N0} Kč'}" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Classes="Card" Margin="0,0,20,0" Padding="25" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0" Text="SPRÁVA TRVALÝCH PLATEB" Classes="SectionTitle" Margin="0,0,0,20"/>      
                    <WrapPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBox Width="120" Text="{Binding ExtendedVm.RecAmountText}" Watermark="Částka (Kč)" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,10,10" Padding="10,8"/>
                        <CalendarDatePicker Width="140" SelectedDate="{Binding ExtendedVm.RecDate}" Watermark="Den platby" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,10,10" Padding="10,8"/>
                        <TextBox Width="160" Text="{Binding ExtendedVm.RecNote}" Watermark="Název (např. Nájem)" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,10,10" Padding="10,8"/>
                        <ComboBox Width="140" ItemsSource="{Binding ExtendedVm.AllCategories}" SelectedItem="{Binding ExtendedVm.SelectedRecCategory}" PlaceholderText="Kategorie" Background="#18181B" BorderBrush="#27272A" CornerRadius="8" Margin="0,0,5,10" Padding="10,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Přidat" Classes="primary" Command="{Binding ExtendedVm.AddRecurringCommand}" Margin="0,0,0,10"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ExtendedVm.CurrentRecurringPayments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,5,10">
                                        <Grid ColumnDefinitions="40, *, Auto, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding DayOfMonth, StringFormat='{}{0}.'}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A1A1AA"/>                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Note}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Category.Name}" FontSize="10" Foreground="{Binding Category.Color}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:N0} Kč'}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,20,0"/>
                                            <Button Grid.Column="3" Content="✕" Foreground="#AD3434" Background="Transparent" Command="{Binding $parent[ItemsControl].DataContext.ExtendedVm.DeleteRecurringCommand}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" RowDefinitions="*, Auto, Auto">  
                <Border Grid.Row="0" Classes="Card" Margin="0,0,0,15" Padding="20">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="STRUKTURA VÝDAJŮ" Classes="SectionTitle" Margin="0,0,0,15"/>
                        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,0,0,20">
                            <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding ExtendedVm.PieDateFrom}" Watermark="Od data" Background="#18181B" BorderBrush="#27272A" Margin="0,0,5,0" HorizontalAlignment="Stretch" CornerRadius="8"/>
                            <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding ExtendedVm.PieDateTo}" Watermark="Do data" Background="#18181B" BorderBrush="#27272A" Margin="5,0,0,0" HorizontalAlignment="Stretch" CornerRadius="8"/>
                        </Grid>
                        <lvc:PieChart Grid.Row="2" Series="{Binding ExtendedVm.PieSeries}" LegendPosition="Bottom" MinHeight="300" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="Card" Padding="20" Margin="0,0,0,15" MaxHeight="200">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="SPRÁVA KATEGORIÍ" Classes="SectionTitle" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding ExtendedVm.AllCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="✕" Foreground="#AD3434" Background="Transparent" Padding="5,0" Cursor="Hand" Command="{Binding $parent[ItemsControl].DataContext.ExtendedVm.DeleteCategoryCommand}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                
                <Border Grid.Row="2" Classes="Card" Padding="20">
                    <StackPanel>
                        <TextBlock Text="ZÁLOHA DAT" Classes="SectionTitle" Margin="0,0,0,10"/>
                        <Button Content="Exportovat CSV" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding ExtendedVm.ExportCsvCommand}"
                                CommandParameter="{Binding $parent[Window]}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>