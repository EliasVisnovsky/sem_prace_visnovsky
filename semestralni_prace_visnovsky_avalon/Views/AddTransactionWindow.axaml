<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:semestralni_prace_visnovsky_avalon.ViewModels"
        x:Class="semestralni_prace_visnovsky_avalon.AddTransactionWindow"
        x:DataType="vm:AddTransactionViewModel"
        Title="Nová transakce" Width="420" Height="620"
        Background="#09090B" Foreground="#FAFAFA"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="TextBox, ComboBox, CalendarDatePicker">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,20"/> <!--L T R B--> 
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="ListBox.colorPicker ListBoxItem">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.colorPicker ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#3F3F46" />
        </Style>
    </Window.Styles>



    <Grid Margin="30" RowDefinitions="Auto, *, Auto">

        <TextBlock Grid.Row="0" Text="PŘIDAT TRANSAKCI" FontSize="14" FontWeight="Bold" LetterSpacing="1" Foreground="#FAFAFA" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Classes="label" Text="ČÁSTKA (Kč)"/>
            <TextBox Text="{Binding AmountText}" Watermark="Např. -150 nebo 2000" />

            <TextBlock Classes="label" Text="KATEGORIE"/>
            <ComboBox ItemsSource="{Binding ExistingCategories}" Text="{Binding CategoryName}" SelectedItem="{Binding CategoryName}" IsEditable="True" PlaceholderText="Vyberte nebo napište..."/>

            <TextBlock Classes="label" Text="BARVA (Vytváříte novou kategorii)" IsVisible="{Binding IsColorPickerVisible}"/>
                <ListBox Classes="colorPicker" ItemsSource="{Binding PaletteColors}" SelectedItem="{Binding SelectedColor}" Background="Transparent" BorderThickness="0" Margin="0,0,0,20" IsVisible="{Binding IsColorPickerVisible}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="20" Height="20" CornerRadius="10" Background="{Binding}"/> <!-- uses the entire DataContext as the background color, not a specific property -->
                    </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            <TextBlock Classes="label" Text="POZNÁMKA"/>
            <TextBox Text="{Binding NoteText}" Watermark="Za co to bylo?"/>

            <TextBlock Classes="label" Text="DATUM"/>
            <Grid ColumnDefinitions="*, Auto, Auto">
                <CalendarDatePicker SelectedDate="{Binding TransactionDate}" Grid.Column="0" Margin="0,0,10,20" Watermark="Zvolte datum"/>
                <Button Command="{Binding SetTodayCommand}" Grid.Column="1" Classes="secondary" Content="Dnes" Margin="0,0,10,20"/>
                <Button Command="{Binding SetYesterdayCommand}" Grid.Column="2" Classes="secondary" Content="Včera" Margin="0,0,0,20"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Command="{Binding CancelCommand}" Classes="secondary" Content="Zrušit" Margin="0,0,15,0"/>
            <Button Command="{Binding SaveCommand}" Classes="primary" Content="Uložit transakci"/>
        </StackPanel>
    </Grid>
</Window>