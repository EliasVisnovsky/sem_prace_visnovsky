<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:semestralni_prace_visnovsky_avalon.ViewModels"
        x:Class="semestralni_prace_visnovsky_avalon.Views.TransactionDetailWindow"
        x:DataType="vm:TransactionDetailViewModel"
        Title="Detail transakce" Width="400" Height="450"
        Background="#09090B" Foreground="#FAFAFA"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid Margin="30" RowDefinitions="Auto, *, Auto">
        
        <TextBlock Grid.Row="0" Text="DETAIL TRANSAKCE" FontSize="14" FontWeight="Bold" LetterSpacing="1" Foreground="#FAFAFA" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1">
            <TextBlock Classes="label" Text="ČÁSTKA (Kč)"/>
            <TextBox Text="{Binding AmountText}" />

            <TextBlock Classes="label" Text="KATEGORIE (Pouze ke čtení)"/>
            <TextBox Text="{Binding CategoryName}" IsReadOnly="True" Foreground="#A1A1AA"/>

            <TextBlock Classes="label" Text="POZNÁMKA"/>
            <TextBox Text="{Binding NoteText}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Command="{Binding DeleteCommand}" Background="#EF4444" Foreground="#FAFAFA" CornerRadius="8" Padding="15,10" Content="Smazat" Margin="0,0,15,0" FontWeight="Bold" Cursor="Hand"/>
            <Button Command="{Binding CancelCommand}" Classes="secondary" Content="Zrušit" Margin="0,0,15,0"/>
            <Button Command="{Binding SaveCommand}" Classes="primary" Content="Uložit změny"/>
        </StackPanel>
    </Grid>
</Window>